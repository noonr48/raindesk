{
  "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "Illustrious-XL-v0.1.safetensors"}},
  "2": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{POSITIVE}}", "clip": ["1", 1]}},
  "3": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{NEGATIVE}}", "clip": ["1", 1]}},
  "4": {"class_type": "LoadImage", "inputs": {"image": "{{IMAGE}}"}},
  "5": {"class_type": "LoadImageMask", "inputs": {"image": "{{MASK}}", "channel": "red"}},
  "6": {"class_type": "VAEEncodeForInpaint", "inputs": {"pixels": ["4", 0], "vae": ["1", 2], "mask": ["5", 0], "grow_mask_by": 6}},
  "7": {"class_type": "KSampler", "inputs": {"model": ["1", 0], "seed": "{{SEED}}", "steps": 22, "cfg": 5.5, "sampler_name": "dpmpp_2m", "scheduler": "karras", "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["6", 0], "denoise": 1.0}},
  "8": {"class_type": "VAEDecode", "inputs": {"samples": ["7", 0], "vae": ["1", 2]}},
  "9": {"class_type": "SaveImage", "inputs": {"images": ["8", 0], "filename_prefix": "{{PREFIX}}"}}
}
