--- public/css/app.css
+++ public/css/app.css
@@ -434,0 +435,48 @@
+
+/* ------------------------------------------------------ direction pen */
+
+#canvas.direction-cursor { cursor: crosshair; }
+
+.direction-caption {
+  position: absolute;
+  z-index: 96;
+  display: none;
+  align-items: center;
+  gap: 6px;
+  width: min(320px, calc(100vw - 20px));
+  padding: 6px;
+  border: 1px solid var(--gold-dim);
+  border-radius: 13px;
+  background: rgba(14, 33, 41, .96);
+  box-shadow: 0 12px 34px rgba(3, 12, 16, .28);
+}
+.direction-caption.open { display: flex; }
+.direction-caption input {
+  flex: 1;
+  min-width: 0;
+  border: 0;
+  outline: none;
+  background: transparent;
+  color: var(--cream);
+  font-size: 11.5px;
+  padding: 8px 7px;
+}
+.direction-caption input::placeholder { color: #78939b; }
+.direction-caption > button:not(.direction-caption-cancel) {
+  border: 0;
+  border-radius: 9px;
+  background: var(--gold);
+  color: #241a06;
+  font-weight: 750;
+  font-size: 10px;
+  padding: 8px 9px;
+  white-space: nowrap;
+}
+.direction-caption-cancel {
+  width: 28px;
+  height: 28px;
+  border: 0;
+  background: transparent;
+  color: #9db6bd;
+  font-size: 15px;
+}
