+
+/* ---------------------------------------------------------- beat trail */
+.beat-trail {
+  position: fixed;
+  z-index: 28;
+  left: calc(var(--art-x, 16px) + 16px);
+  bottom: 116px;
+  width: min(340px, calc(100vw - 32px));
+  max-height: min(52vh, 440px);
+  display: none;
+  flex-direction: column;
+  background: rgba(14,33,41,.94);
+  border: 1px solid rgba(243,234,216,.18);
+  border-radius: 14px;
+  box-shadow: 0 18px 48px rgba(0,0,0,.34);
+  overflow: hidden;
+  backdrop-filter: blur(14px);
+}
+.beat-trail.open { display: flex; }
+.beat-trail-head { display:flex; align-items:center; justify-content:space-between; padding:10px 12px 8px; color:var(--cream); }
+.beat-trail-head strong { font-size:12px; font-weight:650; letter-spacing:.04em; }
+.beat-trail-close, .beat-trail-add, .beat-trail-stuck { border:0; color:var(--cream); background:transparent; cursor:pointer; }
+.beat-trail-close { font-size:18px; opacity:.72; }
+.beat-trail-list { overflow:auto; padding:0 8px; }
+.beat-row { display:flex; gap:9px; padding:9px 6px; border-top:1px solid rgba(243,234,216,.09); }
+.beat-order { flex:0 0 20px; color:var(--gold); font-size:11px; padding-top:2px; text-align:center; }
+.beat-copy { min-width:0; }
+.beat-main { color:var(--cream); font-size:12px; line-height:1.35; }
+.beat-meta { color:rgba(243,234,216,.52); font-size:10px; margin-top:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
+.beat-trail-empty { color:rgba(243,234,216,.56); padding:14px 10px; font-size:11px; line-height:1.4; }
+.beat-trail-form { display:flex; gap:6px; padding:8px; border-top:1px solid rgba(243,234,216,.1); }
+.beat-trail-input { flex:1; min-width:0; border:1px solid rgba(243,234,216,.12); background:rgba(243,234,216,.06); color:var(--cream); border-radius:10px; padding:9px 10px; outline:none; font:inherit; font-size:11px; }
+.beat-trail-input::placeholder { color:rgba(243,234,216,.42); }
+.beat-trail-add { width:34px; border-radius:10px; background:rgba(232,176,75,.16); color:var(--gold); font-size:18px; }
+.beat-trail-stuck { margin:0 8px 9px; text-align:left; font-size:10px; color:rgba(243,234,216,.56); padding:5px 3px; }
+.beat-trail.busy { opacity:.72; }
+@media (max-width: 720px) {
+  .beat-trail { left:10px; right:10px; width:auto; bottom:102px; max-height:42vh; }
+}
